#
ifeq ($(OPENMPMACHINE),1)
OMPFLAG ?= -fopenmp
OPT2 += -DOPENMPCODE
# Cython may be linked by a different compiler than the native archive.
# Prefer the runtime reported by the native compiler when it can locate it.
OMP_RUNTIME ?= $(if $(findstring clang,$(shell $(CC) --version)),omp,gomp)
OMP_SUFFIX := $(if $(filter Darwin,$(shell uname -s)),dylib,so)
OMP_RUNTIME_FILE := $(shell $(CC) -print-file-name=lib$(OMP_RUNTIME).$(OMP_SUFFIX))
OMP_PYTHON_LINK ?= $(if $(filter /%,$(OMP_RUNTIME_FILE)),"$(OMP_RUNTIME_FILE)",$(OMPFLAG))
endif
