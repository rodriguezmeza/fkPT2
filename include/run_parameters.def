/* Shared definitions for CLI defaults, parameter files and used-values output.
 * PARAMETER(member, name, default, description)
 * PARAMETER_ALIAS(member, name, default, description, alias)
 */
PARAMETER(fnamePS, fnamePS, "pkl_z05.dat", "Linear spectrum (k, P(k)) at zout")
PARAMETER(classIni, classIni, "", "CLASS input file for a linear spectrum generated in memory")
PARAMETER_ALIAS(is_PS_input_LCDM, is_PS_input_LCDM, "1",
                "1: rescale a LCDM input, 0: use the supplied model spectrum directly", isinLCDM)
PARAMETER_ALIAS(zout, zout, "0.5", "Output redshift", z)
PARAMETER_ALIAS(om, Om, "0.3", "Present matter density fraction", OmegaM)
PARAMETER(h, h, "0.67", "Dimensionless Hubble parameter")

PARAMETER(b1, b1, "1.0", "Linear local bias")
PARAMETER(b2, b2, "0.1", "Second-order local bias")
PARAMETER(bs2, bs2, "-0.1", "Tidal bias")
PARAMETER(b3nl, b3nl, "0.1", "Nonlocal third-order bias")
PARAMETER(alpha0, alpha0, "0.0", "Monopole EFT coefficient")
PARAMETER(alpha2, alpha2, "0.0", "Quadrupole EFT coefficient")
PARAMETER(alpha4, alpha4, "0.0", "Hexadecapole EFT coefficient")
PARAMETER(ctilde, ctilde, "0.0", "Next-order EFT coefficient")
PARAMETER(PshotP, pshotp, "5000", "Poisson shot-noise amplitude")
PARAMETER(alpha0shot, alpha0shot, "1", "Constant shot-noise coefficient")
PARAMETER(alpha2shot, alpha2shot, "0.0", "Shot-noise coefficient multiplying mu^2 k^2")

PARAMETER(kmin, kmin, "1e-3", "Minimum output wavenumber in h/Mpc")
PARAMETER(kmax, kmax, "0.5", "Maximum output wavenumber in h/Mpc")
PARAMETER_ALIAS(Nk, Nk, "120", "Number of output wavenumbers", nk)
PARAMETER_ALIAS(nquadSteps, nquadSteps, "300", "Number of radial loop quadrature points", nquad)
PARAMETER_ALIAS(mgmodel, model, "LCDM", "Gravity model (see options=print-models)", m)
PARAMETER(modelOptions, modelOptions, "", "Model-specific numeric settings (name=value pairs)")
PARAMETER_ALIAS(fR0, fR0, "1.0e-10", "Hu-Sawicki fR0 (the solver uses its magnitude)", fr0)
PARAMETER(screening, screening, "1.0", "Screening source multiplier")
PARAMETER(eps_DGP, eps_DGP, "-1.0", "DGP branch sign")
PARAMETER(rc_DGP, rc_DGP, "1.0", "DGP crossover scale in H0^-1")
PARAMETER_ALIAS(suffixModel, suffixModel, "", "Suffix for generated filenames", suffix)
PARAMETER_ALIAS(model_paramfile, modelParamfile, "", "Reserved model parameter filename", mpf)

/* Real-space CLPT uses Lagrangian biases. */
PARAMETER(clpt, clpt, "false", "Compute real-space CLPT correlation functions")
PARAMETER(clpt_Nk, clpt_Nk, "160", "CLPT loop wavenumber samples")
PARAMETER(clpt_kmin, clpt_kmin, "1e-4", "Minimum CLPT Fourier wavenumber in h/Mpc")
PARAMETER(clpt_kmax, clpt_kmax, "20.0", "Maximum CLPT Fourier wavenumber in h/Mpc")
PARAMETER(clpt_pmax, clpt_pmax, "30.0", "CLPT loop momentum cutoff in h/Mpc")
PARAMETER(clpt_b1, clpt_b1, "0.0", "CLPT first-order local Lagrangian bias")
PARAMETER(clpt_b2, clpt_b2, "0.0", "CLPT second-order local Lagrangian bias")
PARAMETER(clpt_bs2, clpt_bs2, "0.0", "CLPT Lagrangian quadratic tidal bias")
PARAMETER(clpt_b01, clpt_b01, "0.0", "CLPT curvature bias in (Mpc/h)^2")
PARAMETER(gsm, gsm, "false", "Compute Gaussian streaming correlation multipoles")
PARAMETER(c1eft, c1eft, "0.0", "CLPT density EFT counterterm in (Mpc/h)^2")
PARAMETER(c2eft, c2eft, "0.0", "GSM mean pairwise velocity EFT counterterm in (Mpc/h)^2")
PARAMETER_ALIAS(s2eft, s2eft, "0.0", "GSM isotropic dispersion counterterm in (Mpc/h)^2", sigma2eft)
PARAMETER(smin, smin, "1", "Minimum GSM separation")
PARAMETER(smax, smax, "130", "Maximum GSM separation")
PARAMETER_ALIAS(Ns, Ns, "100", "Number of GSM separations", ns)
PARAMETER(rmin, rmin, "1", "Minimum CLPT separation")
PARAMETER(rmax, rmax, "210", "Maximum CLPT separation")
PARAMETER(Nr, Nr, "210", "Number of CLPT separations")
PARAMETER(NqperLogDecade, NqperLogDecade, "100", "CLPT q samples per decade")
PARAMETER(Nk_qFunctionsQuad, Nk_qFunctionsQuad, "1200", "CLPT minimum number of Fourier quadrature panels")
PARAMETER(gsm_width, gsm_width, "100", "GSM line-of-sight integration half-width in Mpc/h")
PARAMETER(gsm_sizeyT, gsm_sizeyT, "160", "GSM line-of-sight quadrature size")
PARAMETER(gsm_NGL, gsm_NGL, "16", "GSM angular integration size")

PARAMETER_ALIAS(quadratureMethod, quadratureMethod, "trapezoid3", "Loop quadrature method", quad)
PARAMETER_ALIAS(ngausslegpoints, ngausslegpoints, "16", "Gauss-Legendre setup size", nglpts)
PARAMETER(epsquad, epsquad, "1.0e-6", "Quadrature setup tolerance")
PARAMETER_ALIAS(x, tauini, "-4.0", "Initial log scale factor", zini)
PARAMETER_ALIAS(dxstr, dtau, "2/5", "Initial ODE step as a number or fraction", dxstr)
PARAMETER_ALIAS(dxmin, dtaumin, "0.0", "Minimum ODE step size", dxmin)
PARAMETER(eps, eps, "0.0001", "ODE tolerance")
PARAMETER(maxnsteps, maxnsteps, "10000", "Maximum number of ODE steps")
PARAMETER(integration_method, integration_method, "rkqs", "ODE method: rkqs or bsstep")

PARAMETER_ALIAS(rootDir, rootDir, "Output", "Output directory", root)
PARAMETER(postprocessing, postprocessing, "false", "Reserved postprocessing control")
PARAMETER(preScript, preScript, "", "Reserved preprocessing command")
PARAMETER(posScript, posScript, "", "Reserved postprocessing command")
PARAMETER_ALIAS(verbose, verbose, "0", "Console verbosity", verb)
PARAMETER_ALIAS(verbose_log, verbose_log, "0", "File logging verbosity", verblog)
#ifdef OPENMPCODE
PARAMETER_ALIAS(numthreads, numberThreads, "16", "Number of OpenMP threads", nthreads)
#else
PARAMETER_ALIAS(numthreads, numberThreads, "1", "Number of threads", nthreads)
#endif
PARAMETER_ALIAS(options, options, "", "Run options (e.g. make-info, print-options, IA-tutor)", opt)
PARAMETER(version, Version, "0.2.0", "fkPT2 version")
